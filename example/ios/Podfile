# Uncommented on purpose. The Flutter template ships this line commented out,
# which leaves the project on CocoaPods' own default (iOS 13 at time of
# writing) while `roas_flutter` and the native `RoasSensor` pod both declare
# iOS 14. The failure that produces is not obvious: `pod install` complains
# about a dependency whose platform is higher than the target's, and the
# obvious fix -- raising it in Xcode -- does not help, because this file is a
# separate setting from the app target's.
platform :ios, '14.0'

# CocoaPods analytics sends network stats synchronously, which slows every
# flutter build. Flutter's own template disables it; kept.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  # ── The line every consuming app needs ────────────────────────────────────
  #
  # `roas_flutter.podspec` declares `s.dependency 'RoasSensor'`, but RoasSensor
  # is NOT on the CocoaPods trunk -- it lives in its own git repository. A
  # podspec cannot name a git source for its own dependency, so the APP has to,
  # and this is the line to copy into your own Podfile.
  #
  # Without it `pod install` fails with:
  #   [!] Unable to find a specification for `RoasSensor`
  # which reads like a broken plugin and is actually a missing source.
  #
  # Pinned to a TAG, not a branch: SPM and CocoaPods both resolve RoasSensor by
  # tag, and a branch would silently move the native SDK under a build that
  # reports a fixed `sdk_version`.
  pod 'RoasSensor', :git => 'https://github.com/rishabhrk2345/Roas-ios-SDK.git', :tag => '0.1.7'

  # Developing against a local checkout of the SDK instead? Comment the line
  # above and use this, pointed at wherever you cloned it:
  #   pod 'RoasSensor', :path => '../../../sdk-ios'

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # Force every pod to the same floor as the app. Some transitive pods
      # default lower and then fail to build against a 14.0 app, with an error
      # that names the pod rather than the mismatch.
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '14.0'
    end
  end
end
